{
  "permissions": {
    "allow": [
      "mcp__Storyblok__search",
      "mcp__Storyblok__describe",
      "mcp__Storyblok__execute_readonly"
    ],
    "ask": [
      "mcp__*__execute_mutating"
    ],
    "deny": [
      "mcp__*__execute_destructive",
      "mcp__*__upload_asset",
      "mcp__*__upload_asset_finish"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__.*__(execute_mutating|execute_destructive|upload_asset|upload_asset_finish)",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-cms-writes.py\" || exit 2",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
